#!/bin/bash
# ==============================================================================
# Git-AI Manager
# AI-powered Git workflow automation with Gemini CLI
# ==============================================================================
#
# Version: 2.3.0
# License: MIT
# Repository: https://github.com/YOUR_USERNAME/git-ai
#
# Requirements:
#   - Git
#   - Gemini CLI (https://github.com/google-gemini/gemini-cli)
#   - Python 3 (for JSON parsing)
#
# Usage:
#   ./git-ai              # Interactive mode
#   ./git-ai init         # Initialize AI session
#   ./git-ai commit       # AI-assisted commit
#   ./git-ai review       # AI code review
#   ./git-ai finish       # Complete branch workflow
#
# ==============================================================================

set -e

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ==============================================================================
# Load Modules
# ==============================================================================

source "$SCRIPT_DIR/lib/config.sh"
source "$SCRIPT_DIR/lib/utils.sh"
source "$SCRIPT_DIR/lib/session.sh"
source "$SCRIPT_DIR/lib/branch.sh"
source "$SCRIPT_DIR/lib/status.sh"
source "$SCRIPT_DIR/lib/quick-actions.sh"
source "$SCRIPT_DIR/lib/stash.sh"
source "$SCRIPT_DIR/lib/ai-actions.sh"
source "$SCRIPT_DIR/lib/workflow.sh"
source "$SCRIPT_DIR/lib/menu.sh"

# ==============================================================================
# Initialization
# ==============================================================================

# Graceful exit on Ctrl+C
trap 'echo -e "\n${DIM}Interrupted. Goodbye!${NC}"; exit 0' INT

# ==============================================================================
# Entry Point
# ==============================================================================

# Check if in git repo
if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    echo -e "${RED}❌ Not a git repository${NC}"
    exit 1
fi

# CLI mode or interactive
case "${1:-}" in
    init)    action_init ;;
    review)  action_ai_review ;;
    commit)  action_ai_commit ;;
    finish)  action_finish ;;
    status)  show_status ;;
    version) echo "git-ai v${VERSION}" ;;
    help)    show_help ;;
    "")      main_loop ;;
    *)       echo "Usage: git-ai [init|review|commit|finish|status|version|help]" ;;
esac
